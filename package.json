{
  "name": "zorux",
  "version": "0.2.6",
  "type": "module",
  "description": "AI-first web framework: API, Web, Mobile — minimal tokens, maximum output",
  "bin": {
    "zorux": "./dist/index.js"
  },
  "main": "./dist/core/index.js",
  "exports": {
    ".": "./dist/core/index.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "bun build ./src/cli/index.ts --outdir=./dist --target=bun --external=mongodb --external=postgres --external=mysql2 --external=mysql2/promise --external=ioredis --external=memcached --external=@aws-sdk/lib-dynamodb --external=@aws-sdk/client-dynamodb --external=stripe --external=resend --external=@sendgrid/mail --external=nodemailer --external=@aws-sdk/client-s3 --external=graphql --external=meilisearch",
    "postbuild": "node -e \"const{cpSync,existsSync,mkdirSync}=require('fs');const{join}=require('path');const fs=require('fs');const s=join(__dirname,'dist/index.js');fs.writeFileSync(s,'#!/usr/bin/env bun\\n'+fs.readFileSync(s,'utf-8'));const src=join(__dirname,'src/views/static');const dst=join(__dirname,'dist/views/static');if(existsSync(src)){mkdirSync(dst,{recursive:true});cpSync(src,dst,{recursive:true,force:true})}\"",
    "dev": "bun --watch ./src/cli/index.ts",
    "prepublishOnly": "bun run build",
    "test": "bun test",
    "test:integration": "bun test tests/integration.test.ts",
    "test:edge": "bun test tests/edge.test.ts",
    "test:fuzz": "bun test tests/fuzz.test.ts",
    "test:concurrent": "bun test tests/concurrent.test.ts"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "drizzle-orm": "^0.33.0",
    "hono": "^4.5.0",
    "js-yaml": "^4.1.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "bun-types": "latest",
    "typescript": "^5.5.0"
  }
}
