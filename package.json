{
  "name": "zorux",
  "version": "0.2.12",
  "type": "module",
  "description": "AI-first web framework: API, Web, Mobile — minimal tokens, maximum output",
  "bin": {
    "zorux": "dist/index.js"
  },
  "main": "./dist/core/index.js",
  "exports": {
    ".": "./src/core/index.ts",
    "./plugin": "./src/core/define-plugin.ts",
    "./telemetry": "./src/core/telemetry/index.ts",
    "./realtime": "./src/core/realtime/index.ts",
    "./jobs": "./src/core/jobs/index.ts",
    "./storage": "./src/core/storage/index.ts",
    "./email": "./src/core/email/index.ts",
    "./cache": "./src/core/cache/index.ts",
    "./payments": "./src/core/payments/index.ts",
    "./search": "./src/core/search/index.ts",
    "./webhooks": "./src/core/webhooks/index.ts"
  },
  "files": [
    "dist",
    "templates",
    "src/core",
    "src/cli",
    "src/views",
    "recipes",
    "presets",
    ".zorux/patterns"
  ],
  "scripts": {
    "build": "bun run build:js && bun run build:css && bun run postbuild",
    "build:js": "bun build ./src/cli/index.ts --outdir=./dist --target=bun --external=mongodb --external=postgres --external=mysql2 --external=mysql2/promise --external=ioredis --external=memcached --external=@aws-sdk/lib-dynamodb --external=@aws-sdk/client-dynamodb --external=stripe --external=resend --external=@sendgrid/mail --external=nodemailer --external=@aws-sdk/client-s3 --external=graphql --external=meilisearch",
    "postbuild": "node -e \"const{readFileSync,writeFileSync,readdirSync,cpSync,existsSync,mkdirSync}=require('fs');const{join}=require('path');const s=join(__dirname,'dist/index.js');let c=readFileSync(s,'utf-8');if(!c.startsWith('#!'))writeFileSync(s,'#!/usr/bin/env bun\\n'+c);const src=join(__dirname,'src/views/static');const dst=join(__dirname,'dist/views/static');if(existsSync(src)){mkdirSync(dst,{recursive:true});for(const f of readdirSync(src)){if(f==='admin.css')continue;cpSync(join(src,f),join(dst,f),{recursive:true,force:true})}}\"",
    "build:css": "bun run scripts/build-css.ts",
    "dev": "bun --watch ./src/cli/index.ts",
    "prepublishOnly": "bun run build",
    "test": "bun test",
    "test:integration": "bun test tests/integration.test.ts",
    "test:edge": "bun test tests/edge.test.ts",
    "test:fuzz": "bun test tests/fuzz.test.ts",
    "test:concurrent": "bun test tests/concurrent.test.ts"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "drizzle-orm": "^0.33.0",
    "hono": "^4.5.0",
    "js-yaml": "^4.1.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.0",
    "@types/js-yaml": "^4.0.9",
    "bun-types": "latest",
    "daisyui": "^5.5.20",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.5.0"
  }
}
